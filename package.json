{
  "name": "@upstand/dgrunner",
  "version": "2.0.1",
  "description": "Clean, minimal, and secure self-hosted GitHub Actions runner CLI with Docker integration",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "dgrunner": "./dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "check:skills": "node scripts/verify-skills.mjs",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node ./dist/index.js",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/UpstandPlatform/dgrunner.git"
  },
  "bugs": {
    "url": "https://github.com/UpstandPlatform/dgrunner/issues"
  },
  "homepage": "https://github.com/UpstandPlatform/dgrunner#readme",
  "keywords": [
    "github-actions",
    "self-hosted-runner",
    "runner",
    "docker",
    "ci-cd",
    "security",
    "automation",
    "agent-skills",
    "skills.sh",
    "claude-code",
    "codex",
    "upstand"
  ],
  "author": "Upstand Team",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^7.3.2",
    "commander": "^13.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
