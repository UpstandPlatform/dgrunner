{
  "name": "dgrunner",
  "version": "1.0.0",
  "description": "Clean, minimal, and secure self-hosted GitHub Actions runner CLI with Docker integration",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "dgrunner": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node ./dist/index.js"
  },
  "keywords": [
    "github-actions",
    "self-hosted-runner",
    "runner",
    "docker",
    "ci-cd",
    "security",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^7.3.2",
    "commander": "^13.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
